/* Modern Industrial Dark Theme (Slate Palette) */

* {
    font-family: "Segoe UI Variable Display", "Segoe UI", "Inter", sans-serif;
    outline: none;
}

QMainWindow {
    background-color: #0F172A; /* Slate 900 */
    color: #F8FAFC;
}

/* Base Widget Text */
QWidget {
    font-size: 14px;
    color: #F1F5F9;
}

/* -------------------------------------
   Cards / Panels
--------------------------------------*/
QFrame#frame_header, QFrame#frame_sidebar, QFrame#frame_instruction, QFrame#frame_logs, QFrame#frame_footer, QFrame#frame_settings, QFrame#frame_cycles_container {
    background-color: #1E293B; /* Slate 800 */
    border-radius: 12px;
    border: 1px solid #334155; /* Slate 700 */
}

QFrame#frame_sidebar {
    background-color: #0F172A;
    border-radius: 0px;
    border: none;
    border-right: 1px solid #334155;
}

/* -------------------------------------
   Typography
--------------------------------------*/
QLabel#lbl_title {
    font-size: 22px;
    font-weight: 800;
    color: #38BDF8; /* Sky 400 */
    letter-spacing: 0.5px;
}

QLabel#lbl_section_title {
    font-size: 13px;
    font-weight: 700;
    color: #94A3B8; /* Slate 400 */
    text-transform: uppercase;
    letter-spacing: 1px;
}

QLabel#lbl_hw_status {
    font-size: 13px;
    font-weight: 700;
    background-color: #064E3B; /* Emerald 900 */
    color: #34D399; /* Emerald 400 */
    border: 1px solid #059669; /* Emerald 600 */
    border-radius: 6px;
    padding: 6px 16px;
}

QLabel#lbl_instruction {
    font-size: 26px;
    font-weight: 600;
    color: #F8FAFC;
    margin-bottom: 10px;
}

QLabel#lbl_live_data {
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 15px;
    font-weight: bold;
    color: #38BDF8;
    background-color: #0F172A;
    padding: 12px 20px;
    border-radius: 8px;
    border: 1px solid #334155;
}

/* Cycle Tracking Elements */
QLabel#lbl_cycle_header {
    font-size: 11px;
    font-weight: 700;
    color: #94A3B8; /* Slate 400 */
    text-transform: uppercase;
    letter-spacing: 1.5px;
}

QLabel#lbl_cycle_counter {
    font-size: 20px;
    font-weight: 800;
    color: #10B981; /* Emerald 500 */
}

QLabel#lbl_cycle_percentage {
    font-size: 20px;
    font-weight: 800;
    color: #34D399; /* Emerald 400 */
}

/* -------------------------------------
   Inputs & Lists
--------------------------------------*/
QComboBox {
    background-color: #0F172A;
    border: 2px solid #334155;
    border-radius: 8px;
    padding: 4px 16px;
    font-size: 16px;
    color: #F8FAFC;
    min-height: 28px;
}

QComboBox:focus {
    border: 2px solid #38BDF8;
    background-color: #131E30;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: none;
}

QComboBox QAbstractItemView {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 4px;
    selection-background-color: #0284C7;
    selection-color: #FFFFFF;
    color: #F8FAFC;
    outline: none;
}

QLineEdit {
    background-color: #0F172A;
    border: 2px solid #334155;
    border-radius: 8px;
    padding: 4px 16px;
    font-size: 16px;
    color: #F8FAFC;
    min-height: 28px;
    selection-background-color: #38BDF8;
}

QLineEdit:focus {
    border: 2px solid #38BDF8;
    background-color: #131E30;
}

QListWidget, QTableWidget, QTextEdit {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px;
    font-size: 14px;
}

QTextEdit {
    font-family: "Cascadia Code", "Consolas", monospace;
    color: #E2E8F0; /* Slate 200 - Brighter for contrast */
    line-height: 1.5;
}

QListWidget::item, QTableWidget::item {
    padding: 8px;
    border-radius: 4px;
}

QListWidget::item:hover, QTableWidget::item:hover {
    background-color: #1E293B;
}

QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #0284C7; /* Sky 600 */
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #1E293B;
    color: #94A3B8;
    font-weight: bold;
    border: none;
    border-bottom: 1px solid #334155;
    padding: 6px;
}

/* -------------------------------------
   Group Box
--------------------------------------*/
QGroupBox {
    font-weight: bold;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 24px;
    background-color: #1E293B;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    left: 10px;
    color: #94A3B8;
}

/* -------------------------------------
   Buttons
--------------------------------------*/
QPushButton {
    background-color: #334155;
    color: #F8FAFC;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    padding: 8px 16px;
}

QPushButton:hover { background-color: #475569; }
QPushButton:pressed { background-color: #1E293B; }
QPushButton:disabled { background-color: #1E293B; color: #64748B; }

/* Navigation Buttons */
QPushButton[objectName^="btn_nav_"] {
    background-color: transparent;
    border-radius: 8px;
    color: #94A3B8;
    text-align: center;
    font-size: 15px;
    font-weight: 600;
}

QPushButton[objectName^="btn_nav_"]:hover {
    background-color: #1E293B;
    color: #38BDF8;
}

QPushButton[objectName^="btn_nav_"]:checked, QPushButton[objectName^="btn_nav_"]:pressed {
    background-color: #38BDF8;
    color: #0F172A;
}

QPushButton#btn_start { background-color: #059669; color: #FFFFFF; }
QPushButton#btn_start:hover { background-color: #10B981; }

QPushButton#btn_done { background-color: #2563EB; color: #FFFFFF; font-size: 16px; }
QPushButton#btn_done:hover { background-color: #3B82F6; }

QPushButton#btn_abort { background-color: #9F1239; color: #FFFFFF; }
QPushButton#btn_abort:hover { background-color: #BE123C; }

QPushButton#btn_emergency {
    background-color: #EF4444;
    color: #FFFFFF;
    font-weight: 900;
    font-size: 16px;
    border: 2px solid #B91C1C;
}
QPushButton#btn_emergency:hover { background-color: #DC2626; }

/* -------------------------------------
   Progress Bar & Splitter
--------------------------------------*/
QProgressBar {
    background-color: #0F172A;
    border: none;
    border-radius: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0EA5E9, stop:1 #3B82F6);
    border-radius: 6px;
    margin: 1px;
}

QProgressBar#cycle_progress_bar {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 8px;
    text-align: center;
}

QProgressBar#cycle_progress_bar::chunk {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #059669, stop:1 #34D399);
    border-radius: 6px;
    margin: 1px;
}

QSplitter::handle {
    background-color: transparent;
    margin: 0px 4px;
}

/* -------------------------------------
   Scrollbars
--------------------------------------*/
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 4px 0 4px 0;
}
QScrollBar::handle:vertical {
    background: #475569;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover { background: #64748B; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 8px;
    margin: 0 4px 0 4px;
}
QScrollBar::handle:horizontal {
    background: #475569;
    min-width: 20px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover { background: #64748B; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }